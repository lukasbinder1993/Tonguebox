<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=yes">
    <title>Lernende KI-Kommunikationshilfe | Personalisiert & Kontextbewusst</title>
    <style>
        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            margin: 0;
            padding: 12px;
            background: transparent;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
            touch-action: manipulation;
        }

        .app {
            max-width: 900px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        /* Karten */
        .card {
            background: rgba(255, 255, 255, 0.96);
            border-radius: 48px;
            box-shadow: 0 4px 14px rgba(0,0,0,0.1);
            overflow: hidden;
            border: 1px solid rgba(0,0,0,0.05);
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 24px;
            background: #f8f8fc;
            font-weight: 600;
            font-size: 1.4rem;
            cursor: pointer;
            min-height: 80px;
        }
        .card-header:active { background: #e9e9ef; }
        .toggle-icon { font-size: 2rem; width: 48px; text-align: center; }
        .card-content { padding: 20px 18px; display: block; }

        /* Riesen-Buttons & Eingabe */
        .gaze-btn {
            background: #1c1c1e;
            color: white;
            border: none;
            border-radius: 80px;
            padding: 16px 22px;
            font-size: 1.2rem;
            font-weight: 500;
            min-height: 74px;
            min-width: 110px;
            cursor: pointer;
            touch-action: manipulation;
            transition: 0.05s linear;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        }
        .gaze-btn:active { transform: scale(0.96); background: #3a3a3e; }
        .button-row { display: flex; flex-wrap: wrap; gap: 14px; margin: 12px 0; align-items: center; }

        .big-textfield {
            width: 100%;
            padding: 20px;
            font-size: 1.4rem;
            border-radius: 48px;
            border: 2px solid #ccc;
            background: white;
            font-family: inherit;
            resize: vertical;
            min-height: 140px;
        }

        /* Autocomplete Vorschläge */
        .autocomplete-suggestions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin: 12px 0 0;
        }
        .suggestion-chip {
            background: #e0e0e6;
            border-radius: 60px;
            padding: 12px 22px;
            font-size: 1.1rem;
            cursor: pointer;
            transition: 0.05s linear;
            touch-action: manipulation;
        }
        .suggestion-chip:active { background: #c0c0c6; transform: scale(0.96); }

        /* KI-Phrasen Panel */
        .phrase-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 14px;
            margin: 16px 0;
        }
        .phrase-btn {
            background: #2c6e9e;
            color: white;
            border: none;
            border-radius: 60px;
            padding: 14px;
            font-size: 1rem;
            min-height: 70px;
        }

        .context-bar {
            background: #eef2ff;
            border-radius: 60px;
            padding: 12px 18px;
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            margin-bottom: 16px;
        }
        .context-badge {
            background: #4f6f8f;
            color: white;
            border-radius: 40px;
            padding: 8px 18px;
            font-size: 0.9rem;
        }
        select, .small-select {
            background: white;
            border-radius: 60px;
            padding: 12px 18px;
            font-size: 1rem;
            border: 1px solid #aaa;
        }

        .voice-panel {
            background: #f0f0f4;
            border-radius: 80px;
            padding: 14px 18px;
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
        }
        .status { background: #e0e0e6; border-radius: 60px; padding: 8px 16px; }
        @media (max-width: 640px) { .gaze-btn { min-height: 70px; font-size: 1.1rem; } }
    </style>
</head>
<body>
<div class="app">

    <!-- Hauptbereich: Text & Vorlesen + Autocomplete + KI-Phrasenvorschläge -->
    <div class="card">
        <div class="card-header" data-toggle="secMain">
            <span>🧠 KI-Textassistent & Vorlesen</span>
            <span class="toggle-icon">▼</span>
        </div>
        <div class="card-content" id="secMainContent">
            <textarea id="mainText" class="big-textfield" placeholder="Schreibe oder tippe... KI schlägt Wörter vor und lernt mit dir."></textarea>
            <div class="autocomplete-suggestions" id="autocompleteSuggestions"></div>
            
            <div class="voice-panel">
                <span>🗣️ Stimme</span>
                <select id="voiceSelect"></select>
                <div class="status" id="voiceStatus">✅ gespeichert</div>
            </div>
            <div class="button-row">
                <button id="readBtn" class="gaze-btn">🔊 Vorlesen</button>
                <button id="stopBtn" class="gaze-btn" style="background:#5e5e66;">⏹️ Stopp</button>
            </div>
        </div>
    </div>

    <!-- Kontextbewusste KI-Phrasenvorschläge (dynamisch + lernend) -->
    <div class="card">
        <div class="card-header" data-toggle="secPhrases">
            <span>✨ KI-Phrasenvorschläge (lernend & kontextbewusst)</span>
            <span class="toggle-icon">▼</span>
        </div>
        <div class="card-content" id="secPhrasesContent">
            <div class="context-bar">
                <span>📌 Aktueller Kontext:</span>
                <span id="currentContextBadge" class="context-badge">Alltag</span>
                <select id="contextSelect">
                    <option value="alltag">🏠 Alltag</option>
                    <option value="telefon">📞 Telefonat</option>
                    <option value="arzt">🩺 Arzt / Notfall</option>
                    <option value="arbeit">💼 Arbeit / Termin</option>
                </select>
                <button id="resetProfileBtn" class="gaze-btn" style="background:#a55; padding:8px 20px; min-height:50px;">🔄 Profil zurücksetzen</button>
            </div>
            <div id="kiPhraseContainer" class="phrase-grid">
                <!-- Dynamische KI-Phrasen werden hier geladen -->
            </div>
            <small>💡 Diese Vorschläge lernen von dir: Je öfter du eine Phrase verwendest, desto öfter taucht sie auf. Der Kontext beeinflusst die Auswahl.</small>
        </div>
    </div>

    <!-- Telefonat-Schnellsprech & Sprachnachrichten + Notfall (wie bisher) -->
    <div class="card">
        <div class="card-header" data-toggle="secPhone">
            <span>📞 Telefon-Soforthilfe & Sprachnachricht</span>
            <span class="toggle-icon">▼</span>
        </div>
        <div class="card-content" id="secPhoneContent">
            <div class="phrase-grid" id="quickPhoneGrid">
                <!-- Dynamische Buttons werden gleich eingefügt, bleiben aber fix -->
            </div>
            <div class="button-row">
                <button id="customPhoneBtn" class="gaze-btn" style="background:#e67e22;">➕ Eigene Phrase (aus Textfeld)</button>
                <button id="createAudioShare" class="gaze-btn" style="background:#007a5e;">🎤 Text → Sprachnachricht</button>
                <button id="shareAudioBtn" class="gaze-btn" style="background:#5856d6;">📤 Teilen</button>
            </div>
            <div id="audioShareStatus" style="background:#f2f2f5; border-radius:48px; padding:12px; margin-top:8px;">⚡ Keine Nachricht</div>
        </div>
    </div>

    <!-- Notfall + Extra -->
    <div class="card emergency-card" style="border-left: 8px solid #ff5e00;">
        <div class="card-header" data-toggle="secEmergency">
            <span>🆘 NOTFALL & unkomplizierte Hilfe</span>
            <span class="toggle-icon">▼</span>
        </div>
        <div class="card-content" id="secEmergencyContent">
            <div class="phrase-grid">
                <button class="gaze-btn emergencyBtn" data-emg="Ich brauche sofort Hilfe! Notruf.">🚨 Notruf</button>
                <button class="gaze-btn emergencyBtn" data-emg="Medizinischer Notfall, bitte kommen Sie schnell.">🩺 Medizin</button>
                <button class="gaze-btn emergencyBtn" data-emg="Kann mir jemand helfen? Ich kann nicht sprechen.">🗣️ Kommunikation</button>
            </div>
            <button id="customEmergencyBtn" class="gaze-btn" style="background:#d00000;">🔴 Eigene Notfall-Ansage</button>
        </div>
    </div>
</div>

<script>
    (function() {
        // ---------- LERNENDES PERSONALISIERUNGS-PROFIL (localStorage) ----------
        let usageProfile = {
            phraseStats: {},  // { "phrase": count }
            contextHistory: []
        };
        const STORAGE_KEY = "kiCommProfile";
        function loadProfile() {
            const saved = localStorage.getItem(STORAGE_KEY);
            if(saved) {
                try {
                    usageProfile = JSON.parse(saved);
                } catch(e) {}
            }
            if(!usageProfile.phraseStats) usageProfile.phraseStats = {};
            if(!usageProfile.contextHistory) usageProfile.contextHistory = [];
        }
        function saveProfile() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(usageProfile));
        }
        // Eine Phrase verwenden (lernen)
        function recordPhraseUsage(phrase, context) {
            if(!phrase || phrase.trim().length === 0) return;
            const key = phrase.trim().toLowerCase();
            usageProfile.phraseStats[key] = (usageProfile.phraseStats[key] || 0) + 1;
            usageProfile.contextHistory.unshift({ phrase: phrase, context: context, timestamp: Date.now() });
            if(usageProfile.contextHistory.length > 100) usageProfile.contextHistory.pop();
            saveProfile();
            // Aktualisiere die KI-Vorschläge (wenn aktueller Kontext)
            updateKIPhraseSuggestions();
        }
        
        // ----- KI-Vorschläge: Basierend auf Kontext + häufig genutzte Phrasen (Top 6)
        function getTopPhrasesByContext(context, limit = 6) {
            // Basis-Phrasen für Kontexte + persönliche meistgenutzte
            const contextPhrases = {
                alltag: ["Wie geht es dir?", "Ich bin müde.", "Lass uns etwas essen.", "Danke für deine Hilfe.", "Ich brauche eine Pause.", "Schönen Tag noch!"],
                telefon: ["Kann ich Sie später zurückrufen?", "Einen Moment bitte.", "Könnten Sie das wiederholen?", "Ja, verstanden.", "Nein, danke.", "Auf Wiederhören."],
                arzt: ["Ich habe Schmerzen hier.", "Brauche ein Rezept.", "Bitte rufen Sie den Notarzt.", "Mir ist schwindelig.", "Welche Medikamente?", "Wann ist der nächste Termin?"],
                arbeit: ["Das ist erledigt.", "Brauche mehr Zeit.", "Termin verschieben?", "Danke für das Meeting.", "Frage per E-Mail beantworten.", "Bis morgen!"]
            };
            let baseList = contextPhrases[context] || contextPhrases.alltag;
            // Persönliche Top-Phrasen aus Stats (die im aktuellen Kontext benutzt wurden – wir nehmen die generell beliebtesten)
            let personalPhrases = Object.entries(usageProfile.phraseStats)
                .sort((a,b) => b[1] - a[1])
                .slice(0, 4)
                .map(entry => entry[0]);
            // Kombinieren: zuerst personal, dann base, einzigartig
            let combined = [...personalPhrases];
            for(let p of baseList) {
                if(!combined.includes(p.toLowerCase())) combined.push(p);
            }
            return combined.slice(0, limit);
        }
        
        let currentContext = "alltag";
        function updateKIPhraseSuggestions() {
            const container = document.getElementById("kiPhraseContainer");
            if(!container) return;
            const phrases = getTopPhrasesByContext(currentContext, 6);
            container.innerHTML = "";
            phrases.forEach(phrase => {
                const btn = document.createElement("button");
                btn.className = "gaze-btn phrase-btn";
                btn.innerText = phrase;
                btn.style.background = "#2c6e9e";
                btn.addEventListener("click", () => {
                    // Text in das Hauptfeld einfügen (oder anhängen)
                    const textarea = document.getElementById("mainText");
                    const currentText = textarea.value;
                    if(currentText.trim().length > 0 && !currentText.endsWith(" ") && !currentText.endsWith("\n")) {
                        textarea.value = currentText + " " + phrase;
                    } else {
                        textarea.value = currentText + phrase;
                    }
                    textarea.focus();
                    recordPhraseUsage(phrase, currentContext);
                    // Optional: direkt vorlesen? nicht nötig, aber Nutzer kann selbst vorlesen.
                    generateAutocompleteSuggestions(); // Aktualisiere Wortvorschläge
                });
                container.appendChild(btn);
            });
        }
        
        // ---------- Vorausschauende Texteingabe (Autocomplete) basierend auf personalisiertem Wörterbuch + Standardwörtern ----------
        let commonWords = ["ich", "du", "er", "sie", "wir", "ihr", "sie", "haben", "sein", "werden", "können", "möchten", "bitte", "danke", "ja", "nein", "vielleicht", "heute", "morgen", "gestern", "Termin", "Arzt", "Hilfe", "Telefon", "Nachricht"];
        function getPersonalWords() {
            // Wörter aus den genutzten Phrasen extrahieren
            let wordsSet = new Set(commonWords);
            for(let phrase in usageProfile.phraseStats) {
                let parts = phrase.split(/\s+/);
                parts.forEach(w => { if(w.length > 2) wordsSet.add(w.toLowerCase()); });
            }
            return Array.from(wordsSet);
        }
        
        function generateAutocompleteSuggestions() {
            const textarea = document.getElementById("mainText");
            const container = document.getElementById("autocompleteSuggestions");
            let value = textarea.value;
            let lastWordMatch = value.match(/(\S+)$/);
            if(!lastWordMatch) { container.innerHTML = ""; return; }
            let lastWord = lastWordMatch[1].toLowerCase();
            if(lastWord.length < 2) { container.innerHTML = ""; return; }
            const wordBank = getPersonalWords();
            let matches = wordBank.filter(w => w.startsWith(lastWord)).slice(0, 5);
            if(matches.length === 0) { container.innerHTML = ""; return; }
            container.innerHTML = "";
            matches.forEach(match => {
                let chip = document.createElement("div");
                chip.className = "suggestion-chip";
                chip.innerText = match;
                chip.addEventListener("click", () => {
                    let current = textarea.value;
                    let newVal = current.replace(/(\S+)$/, match);
                    textarea.value = newVal;
                    textarea.focus();
                    generateAutocompleteSuggestions();
                });
                container.appendChild(chip);
            });
        }
        
        // ---------- Globale Sprach- und UI-Funktionen (Vorlesen, Stimme etc.) ----------
        let currentUtterance = null;
        let selectedVoice = null;
        let lastShareBlob = null;
        
        const textarea = document.getElementById("mainText");
        const voiceSelect = document.getElementById("voiceSelect");
        const readBtn = document.getElementById("readBtn");
        const stopBtn = document.getElementById("stopBtn");
        const voiceStatusSpan = document.getElementById("voiceStatus");
        
        function populateVoices() {
            const voices = speechSynthesis.getVoices();
            if(!voices.length) return;
            voiceSelect.innerHTML = '';
            let preferred = 0;
            voices.forEach((v, idx) => {
                const opt = document.createElement('option');
                opt.value = idx;
                opt.textContent = `${v.name} (${v.lang})`;
                if(v.lang.includes('de')) preferred = idx;
                voiceSelect.appendChild(opt);
            });
            voiceSelect.selectedIndex = preferred;
            updateSelectedVoice();
        }
        function updateSelectedVoice() {
            const voices = speechSynthesis.getVoices();
            const idx = parseInt(voiceSelect.value);
            if(voices[idx]) selectedVoice = voices[idx];
            voiceStatusSpan.innerText = selectedVoice ? `🎤 ${selectedVoice.name}` : "Standard";
        }
        function speakText(text) {
            if(!text.trim()) text = "Bitte Text eingeben.";
            stopSpeaking();
            const utterance = new SpeechSynthesisUtterance(text);
            if(selectedVoice) utterance.voice = selectedVoice;
            utterance.lang = selectedVoice?.lang || 'de-DE';
            utterance.rate = 0.95;
            currentUtterance = utterance;
            utterance.onend = () => { currentUtterance = null; };
            speechSynthesis.speak(utterance);
        }
        function stopSpeaking() { if(speechSynthesis.speaking || speechSynthesis.pending) speechSynthesis.cancel(); currentUtterance = null; }
        function playPhrase(phrase) { stopSpeaking(); const utter = new SpeechSynthesisUtterance(phrase); if(selectedVoice) utter.voice = selectedVoice; speechSynthesis.speak(utter); recordPhraseUsage(phrase, currentContext); }
        
        readBtn.addEventListener('click', () => speakText(textarea.value));
        stopBtn.addEventListener('click', stopSpeaking);
        voiceSelect.addEventListener('change', updateSelectedVoice);
        if(speechSynthesis.onvoiceschanged) speechSynthesis.onvoiceschanged = populateVoices;
        populateVoices();
        textarea.addEventListener('input', generateAutocompleteSuggestions);
        
        // ---------- Kontextauswahl ----------
        const contextSelect = document.getElementById("contextSelect");
        const contextBadge = document.getElementById("currentContextBadge");
        contextSelect.addEventListener("change", (e) => {
            currentContext = e.target.value;
            contextBadge.innerText = contextSelect.options[contextSelect.selectedIndex].text;
            updateKIPhraseSuggestions();
        });
        document.getElementById("resetProfileBtn").addEventListener("click", () => {
            usageProfile = { phraseStats: {}, contextHistory: [] };
            saveProfile();
            updateKIPhraseSuggestions();
            generateAutocompleteSuggestions();
            alert("Persönliches Sprachprofil wurde zurückgesetzt.");
        });
        
        // ----- Telefon-Buttons (fix + zusätzlich dynamisch) -----
        const quickPhoneGrid = document.getElementById("quickPhoneGrid");
        const quickPhones = [
            "📞 Rückruf: Kann ich Sie später zurückrufen?",
            "⏳ Moment: Einen Moment bitte.",
            "🔄 Wiederholung: Könnten Sie das wiederholen?",
            "❌ Nicht korrekt: Das stimmt nicht.",
            "🫂 Geduld: Ich nutze unterstützte Kommunikation.",
            "👍 Auf Wiederhören: Danke, tschüss!"
        ];
        quickPhoneGrid.innerHTML = "";
        quickPhones.forEach(item => {
            let [emojiText, phrase] = item.split(": ");
            const btn = document.createElement("button");
            btn.className = "gaze-btn";
            btn.innerText = emojiText;
            btn.style.background = "#3c6e71";
            btn.addEventListener("click", () => playPhrase(phrase));
            quickPhoneGrid.appendChild(btn);
        });
        document.getElementById("customPhoneBtn").addEventListener("click", () => {
            let custom = textarea.value.trim();
            if(!custom) custom = "Bitte Text eingeben.";
            playPhrase(custom);
        });
        
        // Sprachnachricht
        function prepareVoiceMessage() {
            const msg = textarea.value.trim();
            if(!msg) { alert("Bitte Text eingeben"); return null; }
            const content = `🔊 KI-Sprachnachricht:\n"${msg}"\n\n💡 Vorgelesen mit Kommunikationshilfe.`;
            const blob = new Blob([content], {type: 'text/plain'});
            lastShareBlob = blob;
            document.getElementById("audioShareStatus").innerHTML = `✅ Nachricht erstellt: "${msg.substring(0,60)}"<br>Jetzt teilen.`;
            return blob;
        }
        document.getElementById("createAudioShare").addEventListener("click", prepareVoiceMessage);
        document.getElementById("shareAudioBtn").addEventListener("click", async () => {
            if(!lastShareBlob) prepareVoiceMessage();
            if(!lastShareBlob) return;
            const file = new File([lastShareBlob], "Sprachnachricht.txt", {type: "text/plain"});
            if(navigator.share) {
                try { await navigator.share({ title: "Meine Sprachnachricht", files: [file] }); } catch(e) {}
            } else {
                const url = URL.createObjectURL(lastShareBlob);
                const a = document.createElement('a'); a.href = url; a.download = "Sprachnachricht.txt"; a.click();
                URL.revokeObjectURL(url);
            }
        });
        
        // Notfall
        document.querySelectorAll(".emergencyBtn").forEach(btn => {
            btn.addEventListener("click", () => {
                const msg = btn.getAttribute("data-emg");
                if(msg) playPhrase(msg);
            });
        });
        document.getElementById("customEmergencyBtn").addEventListener("click", () => {
            let txt = textarea.value.trim();
            if(!txt) txt = "Ich benötige sofort Hilfe!";
            playPhrase(txt);
        });
        
        // Auf-/Zuklappen
        document.querySelectorAll('.card-header').forEach(header => {
            const targetId = header.getAttribute('data-toggle');
            let contentDiv = document.getElementById(targetId + "Content");
            if(contentDiv) {
                contentDiv.style.display = 'block';
                header.addEventListener('click', () => {
                    const isVis = contentDiv.style.display !== 'none';
                    contentDiv.style.display = isVis ? 'none' : 'block';
                    const icon = header.querySelector('.toggle-icon');
                    if(icon) icon.innerText = isVis ? '▶' : '▼';
                });
            }
        });
        
        // Initialisierung: KI Vorschläge, Autocomplete
        loadProfile();
        updateKIPhraseSuggestions();
        generateAutocompleteSuggestions();
        // Wenn eine Phrase im Textfeld über die Vorschläge eingefügt wird, wird recordPhraseUsage schon aufgerufen.
    })();
</script>
</body>
</html>
